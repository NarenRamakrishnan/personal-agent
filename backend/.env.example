# Copy to .env (never commit .env). Get a key from the Nebius Token Factory console.
NEBIUS_API_KEY=
# Optional overrides (defaults come from Nebius's cookbook):
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# PARSER_MODE=auto        # auto | mock | nebius
# Local default is SQLite. For Supabase, paste the pooler URI from Connect, with the
# password percent-encoded if it has symbols. Session pooler (port 5432) for local or a
# long-running server; transaction pooler (port 6543) for serverless hosts.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Spend guard (Nebius has no budget cap, so the backend enforces its own). 0 disables a check.
# LLM_DAILY_CALL_LIMIT=400
# LLM_DAILY_TOKEN_LIMIT=400000
# LLM_CALLS_PER_MINUTE=60
