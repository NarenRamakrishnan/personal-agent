EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_USE_MOCKS=true
# Native phone: use your computer's LAN address instead of localhost.
# Hosted alternative: https://personal-agent-backend.vercel.app
# Leave blank for private per-device authentication (recommended).
# Legacy shared-key mode shares all data among key holders.
# EXPO_PUBLIC values are bundled, never secret; do not embed a production secret.
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_PLACES_URL=https://overpass-api.de/api/interpreter
