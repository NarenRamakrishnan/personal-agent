# Optional. With no .env the app uses the hosted Heedly backend with real parsing.
# Local backend: http://localhost:8000 (browser) or your computer's LAN address (phone).
EXPO_PUBLIC_API_URL=https://personal-agent-backend.vercel.app
# true = sample data on this device, no backend at all.
EXPO_PUBLIC_USE_MOCKS=false
# Leave blank for private per-device authentication (recommended).
# Legacy shared-key mode shares all data among key holders.
# EXPO_PUBLIC values are bundled, never secret; do not embed a production secret.
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_PLACES_URL=https://overpass-api.de/api/interpreter
